# Telegram — create a bot via @BotFather, get the token; get your chat_id
# by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set exactly ONE of these — whichever you have a key for
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# How often to re-check the Useme feed, in seconds (900 = 15 min)
SCAN_INTERVAL_SECONDS=900

# Optional: Polish residential/ISP proxy for all Useme traffic (scraping +
# offer submission), so requests match the account's verified country instead
# of the server's own IP. Leave all four blank to skip proxying entirely.
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
