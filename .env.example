# Telegram — create a bot via @BotFather, get the token; get your chat_id
# by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set exactly ONE of these — whichever you have a key for
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# How often to re-check the Useme feed, in seconds (900 = 15 min)
SCAN_INTERVAL_SECONDS=900
